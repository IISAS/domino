# ---- build stage ----
FROM python:3.11-slim AS builder

ENV PYTHONUNBUFFERED=1

RUN apt-get update --yes && apt-get install -y --no-install-recommends \
    python3-setuptools \
    python3-gdbm \
    python3-tk \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# for Tensorflow version > 2.15
# downgrade protobuf, see: https://github.com/tensorflow/tensorflow/issues/98980
#RUN pip install --no-cache-dir \
#    "protobuf>=5.28.3,<6" \
#    -t /opt/python

# Install Domino CLI
RUN pip install --no-cache-dir \
    domino-py-spice[cli] \
    -t /opt/python

# ---- runtime stage ----
FROM tensorflow/tensorflow:2.15.0.post1-gpu

# Copy python deps
COPY --from=builder /opt/python /opt/python-domino

ENV PYTHONPATH="/opt/python-domino"

# Expose the `domino` CLI on PATH.
# pip --target placed the executable in /opt/python-domino/bin, but its shebang
# points at the builder's interpreter, which doesn't exist in this image.
# Use a thin wrapper that runs the entry point with the runtime's own python3.
RUN printf '#!/usr/bin/env python3\nimport sys\nfrom domino.cli.cli import cli\nsys.exit(cli())\n' \
        > /usr/local/bin/domino \
    && chmod +x /usr/local/bin/domino

# Runtime dirs
RUN mkdir -p \
        /home/domino/pieces_repository \
        /home/run_data \
        /airflow/xcom \
    && echo "{}" > /airflow/xcom/return.json \
    && chmod -R 777 /home/run_data /airflow/xcom

WORKDIR /home
